# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=weather_report
PORT=3000
LOG_LEVEL=info

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Open-Meteo API Configuration
OPEN_METEO_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

# Note: Update these values with your actual PostgreSQL and Redis credentials
# Before running migrations or starting the application
# Redis is optional but recommended for caching
